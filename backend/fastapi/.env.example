# ZASKA Backend — Environment Variables Reference
# Copy this file to .env and fill in all required values.
# NEVER commit .env with real secrets to git.
#
# Variables marked [REQUIRED] cause startup failure if missing.
# Variables marked [PRODUCTION] cause startup failure only in ENV=production.
# Variables marked [CRITICAL] — silent failure if missing (money not credited, features disabled).

# ════════════════════════════════════════════
# CORE — [REQUIRED]
# ════════════════════════════════════════════

# Environment: development | staging | production
ENV=development

# [REQUIRED] Database URL — set automatically by docker-compose (points to PgBouncer)
# For local dev without Docker: use direct PostgreSQL URL
DATABASE_URL=postgresql+psycopg://zaska_admin:CHANGE_ME@localhost:5417/zaska

# Used by Alembic to bypass PgBouncer for migrations (set by docker-compose automatically)
ALEMBIC_DATABASE_URL=postgresql+psycopg://zaska_admin:CHANGE_ME@localhost:5432/zaska

# [REQUIRED] JWT secret — minimum 32 random characters
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GENERATE_64_CHAR_RANDOM_STRING_HERE

JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ════════════════════════════════════════════
# REDIS
# ════════════════════════════════════════════

REDIS_URL=redis://localhost:16379/0

# Async Redis pool cap — prevents pool explosion under WebSocket storms
REDIS_MAX_ASYNC_CONNECTIONS=200

# ════════════════════════════════════════════
# DATABASE POOL (set by docker-compose for PgBouncer)
# ════════════════════════════════════════════

# With PgBouncer: 3 (PgBouncer multiplexes concurrency)
# Without PgBouncer: 10
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# ════════════════════════════════════════════
# SECURITY
# ════════════════════════════════════════════

# [PRODUCTION] Must be your real domain in production
CORS_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:5173,http://localhost:5174

# [PRODUCTION] Rate limiting
RATE_LIMIT_MAX_REQUESTS=180
RATE_LIMIT_WINDOW_SECONDS=60

# WebSocket ticket TTL (seconds)
WS_TICKET_TTL_SECONDS=60

# ════════════════════════════════════════════
# ADMIN
# ════════════════════════════════════════════

ADMIN_ROLE=admin

# [CRITICAL] One-time secret to bootstrap the first admin user.
# Steps: 1) Set this variable, 2) POST /api/admin/bootstrap with this secret,
#        3) REMOVE this variable immediately after (security risk if left set).
ADMIN_BOOTSTRAP_SECRET=CHANGE_ME_THEN_REMOVE

# Admin emails for KYC review alerts (comma-separated)
ADMIN_NOTIFICATION_EMAILS=

# ════════════════════════════════════════════
# PLATFORM ECONOMICS — [CRITICAL]
# ════════════════════════════════════════════

# [CRITICAL] User ID of the ZASKA platform wallet that receives the 15% commission.
# MUST be set before any escrow release, otherwise commissions are lost (logged as WARNING).
# Steps: 1) Create a user account for the platform, 2) Get their user_id from DB,
#        3) Set this variable.
ZASKA_WALLET_USER_ID=

# Platform commission in basis points (1500 = 15%)
ZASKA_COMMISSION_BPS=1500

# ════════════════════════════════════════════
# PAYMENTS — [PRODUCTION REQUIRED]
# ════════════════════════════════════════════

# Payment mode: mock (dev only) | sandbox | production
PAYMENT_MODE=mock
REAL_MONEY_ENABLED=false
PAYMENTS_DISABLED=false

# [PRODUCTION] Must be real HTTPS URLs in production
PAYMENT_WEBHOOK_BASE_URL=http://localhost:6969
PAYMENT_REDIRECT_URL=http://localhost:3010/payment/success

# ── Stripe (required in production for EU countries) ──────────────────────────
# sandbox: sk_test_...   production: sk_live_...
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ── FedaPay (required in production for West Africa — XOF zone) ───────────────
FEDAPAY_API_KEY=
FEDAPAY_ENV=sandbox
FEDAPAY_WEBHOOK_SECRET=

# ── Flutterwave (sub-Saharan Africa) ──────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_HASH=

# ── Paystack (Nigeria — NGN) ───────────────────────────────────────────────────
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# ════════════════════════════════════════════
# OTP / EMAIL — [PRODUCTION REQUIRED]
# ════════════════════════════════════════════

# mock: logs OTP to console (development only)
# smtp: sends email via Brevo API (required for staging and production)
OTP_PROVIDER=mock
OTP_PROVIDER_ENABLED=true
KYC_PROVIDER_ENABLED=true

# [REQUIRED when OTP_PROVIDER=smtp] Brevo HTTP API key
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=noreply@zaska.app
EMAIL_FROM_NAME=ZASKA
APP_FRONTEND_URL=http://localhost:3010

# ════════════════════════════════════════════
# PUSH NOTIFICATIONS
# ════════════════════════════════════════════

# Path to Firebase service account JSON (inside container).
# Leave empty to disable push notifications silently.
# Example: /app/firebase-service-account.json
FCM_SERVICE_ACCOUNT_PATH=
FCM_PROJECT_ID=

# ════════════════════════════════════════════
# FILE UPLOADS (Cloudinary)
# ════════════════════════════════════════════

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MAX_UPLOAD_BYTES=5242880

# ════════════════════════════════════════════
# FX RATES (1 USD = X currency)
# ════════════════════════════════════════════

FX_USD_TO_XOF=620.0
FX_USD_TO_XAF=620.0
FX_USD_TO_GHS=15.5
FX_USD_TO_NGN=1650.0
FX_USD_TO_KES=130.0
FX_USD_TO_EUR=0.92
FX_FEE_BPS=50
FX_MAX_PER_TX_USD=10000.0
FX_MAX_DAILY_USD=50000.0

# ════════════════════════════════════════════
# TRANSACTION LIMITS
# ════════════════════════════════════════════

MAX_WITHDRAWAL_PER_DAY_USD=5000.0
MAX_DEPOSIT_PER_DAY_USD=50000.0
PAYOUT_FAIL_BLOCK_THRESHOLD=3
RAPID_CYCLE_WINDOW_MINUTES=10

# ════════════════════════════════════════════
# OBSERVABILITY
# ════════════════════════════════════════════

# Sentry DSN (leave empty to disable error tracking)
SENTRY_DSN=

# ════════════════════════════════════════════
# BACKUPS
# ════════════════════════════════════════════

BACKUP_DIR=/app/backups
BACKUP_KEEP_DAYS=7

# ════════════════════════════════════════════
# UVICORN
# ════════════════════════════════════════════

# Number of uvicorn workers per pod.
# Default 1: safe for in-process scheduler (scheduler runs once per pod).
# Production: set to number of CPUs for full CPU utilisation.
# With distributed Redis locks (in place), multiple workers are safe.
WEB_CONCURRENCY=1
