## ZASKA certification profile: LOCAL / ISOLATED WITH DOCKER
## Use this file when certifying on the local Docker stack, never against production.
## If you need a shared staging environment, start from:
## `backend/fastapi/.env.certification.staging.example`

ENV=development
CERTIFICATION_RUNTIME=docker-compose
APP_NAME=ZASKA API
APP_HOST=127.0.0.1
APP_PORT=6969

# --- Docker certification database / cache ---
# Local certification bypasses PgBouncer on purpose:
# - simpler startup
# - isolates backend correctness from pooler image issues
DATABASE_URL=postgresql+psycopg://zaska_admin:replace-postgres-password@postgres:5432/zaska
ALEMBIC_DATABASE_URL=postgresql+psycopg://zaska_admin:replace-postgres-password@postgres:5432/zaska
REDIS_URL=redis://:replace-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-redis-password@redis:6379/2

# --- Security ---
JWT_SECRET=replace-with-a-64-char-or-longer-secret-for-certification-only
OTP_SECRET=replace-with-a-different-long-secret-for-certification-only
API_PREFIX=/api

# --- Web / CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:5173,http://localhost:5174
APP_FRONTEND_URL=http://localhost:3010

# --- Payments / providers in safe mode ---
PAYMENT_MODE=sandbox
REAL_MONEY_ENABLED=false
PAYMENTS_DISABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
FEDAPAY_API_KEY=
FEDAPAY_ENV=sandbox
FEDAPAY_WEBHOOK_SECRET=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_HASH=
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYMENT_WEBHOOK_BASE_URL=http://127.0.0.1:6969
PAYMENT_REDIRECT_URL=http://localhost:3010/payment/success

# --- OTP / email ---
# In ENV=development, OTP_PROVIDER=mock is allowed and safest locally.
OTP_PROVIDER=mock
OTP_PROVIDER_ENABLED=true
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=no-reply-certification@zaska.local
EMAIL_FROM_NAME=ZASKA Certification
ADMIN_NOTIFICATION_EMAILS=ops-certification@zaska.local

# --- KYC / compliance ---
KYC_PROVIDER_ENABLED=true
TURNSTILE_SECRET_KEY=
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# --- Platform/system wallets ---
# On Docker certification runs, these are auto-seeded by the backend entrypoint.
ZASKA_WALLET_USER_ID=
PENSION_FUND_USER_ID=
HEALTH_FUND_USER_ID=
SMOOTHING_FUND_USER_ID=

# --- Optional services ---
SENTRY_DSN=
FCM_SERVICE_ACCOUNT_PATH=
FCM_PROJECT_ID=

# --- Backups / ops ---
BACKUP_DIR=backend/fastapi/backups
BACKUP_KEEP_DAYS=3
