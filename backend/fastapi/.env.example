# ZASKA Backend — Environment Variables
# Copy to .env and fill in real values. NEVER commit .env with real secrets.

# ── App ──────────────────────────────────────────────────────────────────────
ENV=development
APP_NAME=ZASKA API
APP_HOST=0.0.0.0
APP_PORT=6969

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+psycopg://zaska_admin:CHANGE_ME@localhost:5417/zaska

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:16379/0
CELERY_BROKER_URL=redis://localhost:16379/1
CELERY_RESULT_BACKEND=redis://localhost:16379/2

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=GENERATE_64_CHAR_RANDOM_STRING_HERE
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ── Paiements ────────────────────────────────────────────────────────────────
PAYMENT_MODE=mock
PAYMENTS_DISABLED=false
REAL_MONEY_ENABLED=false

# ── Stripe (sandbox: sk_test_..., production: sk_live_...) ───────────────────
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# ── FedaPay (Afrique de l'Ouest — XOF) ───────────────────────────────────────
FEDAPAY_API_KEY=
FEDAPAY_ENV=sandbox
FEDAPAY_WEBHOOK_SECRET=

# ── Flutterwave (Afrique sub-saharienne) ──────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_HASH=

# ── Webhooks & Redirects ──────────────────────────────────────────────────────
PAYMENT_WEBHOOK_BASE_URL=http://localhost:6969
PAYMENT_REDIRECT_URL=http://localhost:3010/payment/success

# ── OTP Provider ──────────────────────────────────────────────────────────────
# mock  → log console uniquement (développement sans Brevo)
# smtp  → envoi email via Brevo SMTP (recommandé dès sandbox)
OTP_PROVIDER=mock
OTP_PROVIDER_ENABLED=true
BYPASS_OTP=false

# ── SMTP Brevo (requis si OTP_PROVIDER=smtp) ──────────────────────────────────
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_LOGIN=your_brevo_login@example.com
SMTP_PASSWORD=your_brevo_smtp_password
SMTP_FROM_EMAIL=no-reply@zaska.app

# ── Email (Brevo API) ─────────────────────────────────────────────────────────
BREVO_API_KEY=
EMAIL_FROM_ADDRESS=noreply@zaska.app
EMAIL_FROM_NAME=ZASKA

# ── FX ────────────────────────────────────────────────────────────────────────
FX_USD_TO_XOF=620.0
FX_FEE_BPS=50

# ── Monitoring ────────────────────────────────────────────────────────────────
SENTRY_DSN=

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:5173,http://localhost:5174

# ── Rate limiting & misc ──────────────────────────────────────────────────────
WS_TICKET_TTL_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=180
RATE_LIMIT_WINDOW_SECONDS=60
PAYMENT_IDEMPOTENCY_TTL_SECONDS=180
