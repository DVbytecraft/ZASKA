## ZASKA certification profile: SHARED STAGING
## Use this file for a real certification environment that mirrors production
## while still staying sandbox / non-live on providers.

ENV=staging
CERTIFICATION_RUNTIME=docker-compose
APP_NAME=ZASKA API
APP_HOST=0.0.0.0
APP_PORT=6969

# --- Staging database / cache ---
# Local certification path bypasses PgBouncer.
# For shared staging, you may switch DATABASE_URL back to pgbouncer if that image/service is validated there.
DATABASE_URL=postgresql+psycopg://zaska_admin:replace-postgres-password@postgres:5432/zaska
ALEMBIC_DATABASE_URL=postgresql+psycopg://zaska_admin:replace-postgres-password@postgres:5432/zaska
REDIS_URL=redis://:replace-redis-password@redis:6379/0
CELERY_BROKER_URL=redis://:replace-redis-password@redis:6379/1
CELERY_RESULT_BACKEND=redis://:replace-redis-password@redis:6379/2

# --- Security ---
JWT_SECRET=replace-with-a-64-char-or-longer-secret-for-staging-only
OTP_SECRET=replace-with-a-different-long-secret-for-staging-only
API_PREFIX=/api

# --- Web / CORS / callback URLs ---
CORS_ALLOWED_ORIGINS=https://staging.zaska.app,https://admin-staging.zaska.app
APP_FRONTEND_URL=https://staging.zaska.app
PAYMENT_WEBHOOK_BASE_URL=https://api-staging.zaska.app
PAYMENT_REDIRECT_URL=https://staging.zaska.app/payment/success

# --- Payments / providers in safe mode ---
PAYMENT_MODE=sandbox
REAL_MONEY_ENABLED=false
PAYMENTS_DISABLED=false
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_PUBLISHABLE_KEY=pk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
FEDAPAY_API_KEY=sandbox_replace_me
FEDAPAY_ENV=sandbox
FEDAPAY_WEBHOOK_SECRET=replace_me
FLUTTERWAVE_SECRET_KEY=test_replace_me
FLUTTERWAVE_HASH=replace_me
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=

# --- OTP / email ---
# In ENV=staging, OTP_PROVIDER=mock is NOT allowed by config.
OTP_PROVIDER=smtp
OTP_PROVIDER_ENABLED=true
BREVO_API_KEY=replace_me
EMAIL_FROM_ADDRESS=no-reply-staging@zaska.app
EMAIL_FROM_NAME=ZASKA Staging
ADMIN_NOTIFICATION_EMAILS=ops-staging@zaska.app

# --- KYC / compliance ---
KYC_PROVIDER_ENABLED=true
TURNSTILE_SECRET_KEY=replace_with_cloudflare_test_key
ANTHROPIC_API_KEY=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1

# --- Platform/system wallets ---
# On Docker staging runs, these are auto-seeded by the backend entrypoint.
ZASKA_WALLET_USER_ID=
PENSION_FUND_USER_ID=
HEALTH_FUND_USER_ID=
SMOOTHING_FUND_USER_ID=

# --- Optional services ---
SENTRY_DSN=
FCM_SERVICE_ACCOUNT_PATH=
FCM_PROJECT_ID=

# --- Backups / ops ---
BACKUP_DIR=/app/backups
BACKUP_KEEP_DAYS=3
