{
  "id": null,
  "uid": "zaska-overview",
  "title": "ZASKA — Vue d'ensemble",
  "tags": ["zaska", "production"],
  "timezone": "Africa/Lome",
  "refresh": "30s",
  "schemaVersion": 39,
  "panels": [
    {
      "id": 1,
      "title": "Requêtes HTTP / sec",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "targets": [{
        "expr": "rate(wosystm_http_requests_total[1m])",
        "legendFormat": "req/s"
      }],
      "options": { "colorMode": "background", "graphMode": "area" }
    },
    {
      "id": 2,
      "title": "Taux d'erreurs HTTP (%)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "targets": [{
        "expr": "100 * rate(wosystm_http_requests_total{status=~\"[45]xx\"}[5m]) / rate(wosystm_http_requests_total[5m])",
        "legendFormat": "erreurs %"
      }],
      "options": {
        "colorMode": "background",
        "thresholds": { "steps": [{"color": "green", "value": 0}, {"color": "yellow", "value": 1}, {"color": "red", "value": 5}] }
      }
    },
    {
      "id": 3,
      "title": "Latence P95 (ms)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "targets": [{
        "expr": "histogram_quantile(0.95, rate(wosystm_http_duration_ms_bucket[5m]))",
        "legendFormat": "P95"
      }],
      "options": { "colorMode": "background" }
    },
    {
      "id": 4,
      "title": "Mémoire Heap Node.js (MB)",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "targets": [{
        "expr": "nodejs_heap_used_bytes / 1024 / 1024",
        "legendFormat": "Heap MB"
      }],
      "options": { "colorMode": "background" }
    },
    {
      "id": 5,
      "title": "Paiements initiés / heure",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "targets": [{
        "expr": "sum by (provider) (rate(wosystm_payment_initiated_total[1h]) * 3600)",
        "legendFormat": "{{provider}}"
      }]
    },
    {
      "id": 6,
      "title": "Taux de succès paiements",
      "type": "gauge",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "targets": [{
        "expr": "100 * sum(rate(wosystm_payment_success_total[1h])) / sum(rate(wosystm_payment_initiated_total[1h]))",
        "legendFormat": "Succès %"
      }],
      "options": { "minValue": 0, "maxValue": 100 }
    },
    {
      "id": 7,
      "title": "Requêtes HTTP par route",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 12 },
      "targets": [{
        "expr": "topk(10, sum by (route, method) (rate(wosystm_http_requests_total[5m])))",
        "legendFormat": "{{method}} {{route}}"
      }]
    },
    {
      "id": 8,
      "title": "Connexions actives Auth",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 20 },
      "targets": [
        {
          "expr": "rate(wosystm_auth_login_total{success=\"true\"}[5m]) * 300",
          "legendFormat": "Logins OK / 5min"
        },
        {
          "expr": "rate(wosystm_auth_login_total{success=\"false\"}[5m]) * 300",
          "legendFormat": "Logins échoués / 5min"
        }
      ]
    },
    {
      "id": 9,
      "title": "Cas de modération",
      "type": "barchart",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 20 },
      "targets": [{
        "expr": "sum by (severity) (increase(wosystm_moderation_case_total[24h]))",
        "legendFormat": "{{severity}}"
      }]
    }
  ],
  "time": { "from": "now-6h", "to": "now" }
}
